DATABASE_URL=sqlite:///drojun.db
FLASK_SECRET_KEY=replace-with-a-long-random-value
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-long-random-password
WEBHOOK_SECRET=replace-with-a-long-random-value
KITE_API_KEY=replace-me
KITE_API_SECRET=replace-me
KITE_USER_ID=replace-with-your-zerodha-user-id
KITE_CREDENTIALS_FILE=/var/lib/drojun/kite_credentials.json
ESTIMATED_IV=0.18
SIGNAL_MAX_AGE_SECONDS=300
GATEWAY_SHARED_SECRET=use-the-same-random-secret-on-railway-and-the-droplet
REQUIRE_GATEWAY_SIGNATURE=true
PORT=8080

