[Unit]
Description=Drojun trading service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=drojun
Group=drojun
WorkingDirectory=/opt/drojun/app
EnvironmentFile=/etc/drojun.env
ExecStart=/opt/drojun/venv/bin/gunicorn --workers 1 --threads 4 --timeout 120 --bind 127.0.0.1:8001 Executor:app
Restart=always
RestartSec=5
StateDirectory=drojun
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/drojun

[Install]
WantedBy=multi-user.target

